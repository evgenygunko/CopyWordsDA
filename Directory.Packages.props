<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Appium.WebDriver" Version="9.0.0" />
    <PackageVersion Include="AutoFixture" Version="4.18.1" />
    <PackageVersion Include="AutoFixture.AutoMoq" Version="4.18.1" />
    <PackageVersion Include="CommunityToolkit.Maui" Version="17.0.0" />
    <PackageVersion Include="CommunityToolkit.Maui.MediaElement" Version="12.0.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="FluentAssertions" Version="[7.*, 8)" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageVersion Include="LaunchDarkly.ClientSdk" Version="5.10.3" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="NUnit" Version="4.6.1" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.14.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Sentry.Maui" Version="7.0.1" />
    <!-- Pin ImageSharp to exactly 3.1.12 to avoid the build-time Six Labors license key requirement
         introduced in v4.0.0 and backported to v3.2.0. This does not remove existing license obligations.
         Known vulnerabilities remain in 3.1.12; the specific audit suppressions below accept that risk.
         https://github.com/SixLabors/docs/blob/main/articles/imagesharp/index.md -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="[3.1.12]" />
    <PackageVersion Include="Syncfusion.Licensing" Version="35.2.12" />
    <PackageVersion Include="Syncfusion.Maui.Expander" Version="35.2.12" />
    <PackageVersion Include="Syncfusion.Maui.Inputs" Version="35.2.12" />
    <PackageVersion Include="Syncfusion.Maui.Toolkit" Version="1.0.12" />
  </ItemGroup>
  <ItemGroup>
    <!-- Suppress only the known ImageSharp 3.1.12 advisories while pinned for the license key reason above.
         These suppressions do not fix the vulnerabilities. Keep NuGet auditing enabled for other advisories. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>
</Project>
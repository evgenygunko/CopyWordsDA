<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/maui/global"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:DataType="SettingsViewModel"
             x:Class="CopyWords.MAUI.Views.SettingsViewAndroid">

    <ContentView.Resources>
        <InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentView.Resources>

    <VerticalStackLayout>

        <!-- Section "Dictionaries" -->
        <Label Text="Dictionaries" Margin="20,10,10,0" FontSize="{StaticResource FontSizeSubtitle}" />

        <VerticalStackLayout
            Margin="20,0,10,0"
            BindableLayout.ItemsSource="{Binding DictionaryOptions}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="DictionaryOptionViewModel">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="Auto"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Style="{StaticResource SettingsLabelStyleAndroid}"
                               VerticalOptions="Center"
                               Text="{Binding Title}" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsEnabled}" />
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>

        <!-- Filler -->
        <BoxView Style="{StaticResource FillerStyle}" />

        <!-- Section "Dictionary mode" -->
        <Label Text="Dictionary mode" Margin="20,0,10,0" FontSize="{StaticResource FontSizeSubtitle}" />

        <Grid Margin="20,0,10,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0"
                   Style="{StaticResource SettingsLabelStyleAndroid}"
                   VerticalOptions="Center"
                   Text="Dictionary mode"/>
            <Switch Grid.Row="0" Grid.Column="1"
                   IsToggled="{Binding ShowAnkiButton, Converter={StaticResource InvertedBoolConverter}}" />
        </Grid>

        <!-- Section "Anki settings" -->
        <VerticalStackLayout IsVisible="{Binding ShowAnkiButton, Converter={StaticResource InvertedBoolConverter}}">
            <Label Text="Anki settings" Margin="20,10,10,0" FontSize="{StaticResource FontSizeSubtitle}" />
            <!-- Anki Deck Name Danish -->
            <Label IsVisible="{Binding IsDanishDictionaryEnabled}" Text="Deck name (Danish):" Margin="20,10,10,0" Style="{StaticResource SettingsLabelStyleAndroid}" />
            <Picker IsVisible="{Binding IsDanishDictionaryEnabled}" Margin="20,0,20,0"
                FontSize="{StaticResource FontSizeBody}"
                TextColor="{DynamicResource PrimaryTextColor}"
                TitleColor="{DynamicResource SecondaryTextColor}"
                Title="Select a deck"
                ItemsSource="{Binding DeckNames}"
                SelectedItem="{Binding AnkiDeckNameDanish}" />

            <!-- Anki Deck Name Spanish -->
            <Label IsVisible="{Binding IsSpanishDictionaryEnabled}" Text="Deck name (Spanish):" Margin="20,10,10,0" Style="{StaticResource SettingsLabelStyleAndroid}" />
            <Picker IsVisible="{Binding IsSpanishDictionaryEnabled}" Margin="20,0,20,0"
                FontSize="{StaticResource FontSizeBody}"
                TextColor="{DynamicResource PrimaryTextColor}"
                TitleColor="{DynamicResource SecondaryTextColor}"
                Title="Select a deck"
                ItemsSource="{Binding DeckNames}"
                SelectedItem="{Binding AnkiDeckNameSpanish}" />

            <!-- Anki Model Name -->
            <Label Text="Model name:" Margin="20,10,10,0" Style="{StaticResource SettingsLabelStyleAndroid}" />
            <Picker Margin="20,0,20,0"
                FontSize="{StaticResource FontSizeBody}"
                TextColor="{DynamicResource PrimaryTextColor}"
                TitleColor="{DynamicResource SecondaryTextColor}"
                Title="Select a model"
                ItemsSource="{Binding ModelNames}"
                SelectedItem="{Binding AnkiModelName}" />
        </VerticalStackLayout>

        <Grid Margin="20,20,10,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="Auto"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource SettingsLabelStyleAndroid}"
                    VerticalOptions="Center"
                    Text="Include translated meanings when copying to the back of the card"/>
            <Switch Grid.Row="0" Grid.Column="1"
                    IsToggled="{Binding CopyTranslatedMeanings}" />
        </Grid>

        <Label Text="Destination language:" Margin="20,10,10,0" Style="{StaticResource SettingsLabelStyleAndroid}" />
        <Picker Margin="20,0,20,0"
                FontSize="{StaticResource FontSizeBody}"
                TextColor="{DynamicResource PrimaryTextColor}"
                TitleColor="{DynamicResource SecondaryTextColor}"
                Title="Select destination language"
                ItemsSource="{Binding DestinationLanguages}"
                SelectedItem="{Binding DestinationLanguage}" />

        <!-- Filler -->
        <BoxView Style="{StaticResource FillerStyle}" />

        <!-- Section "Theme" -->
        <Label Text="Theme" Margin="20,0,10,0" FontSize="{StaticResource FontSizeSubtitle}" />

        <Grid Margin="20,10,20,0">
            <Picker FontSize="{StaticResource FontSizeBody}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    TitleColor="{DynamicResource SecondaryTextColor}"
                    Title="Select a theme"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Themes}"
                    SelectedItem="{Binding SelectedTheme}" />
            <Label Text="&#x25BE;"
                   Margin="0,0,16,0"
                   FontSize="{StaticResource FontSizeBody}"
                   TextColor="{DynamicResource SecondaryTextColor}"
                   HorizontalOptions="End"
                   VerticalOptions="Center"
                   InputTransparent="True"
                   AutomationProperties.IsInAccessibleTree="False" />
        </Grid>

        <!-- Filler -->
        <BoxView Style="{StaticResource FillerStyle}" />

        <!-- Section "Other" -->
        <Label Text="Other" FontSize="{StaticResource FontSizeSubtitle}" Margin="20,0,10,0" />

        <Label Text="About" Margin="20,10,10,0" FontAttributes="Bold" />
        <Label Text="{Binding About}" Margin="20,0,10,0"
                   Style="{StaticResource SettingsLabelStyleAndroid}"
                   VerticalOptions="Center" />
    </VerticalStackLayout>

</ContentView>
